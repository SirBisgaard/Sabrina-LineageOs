+        // INTERNET is a normal permission, granted to every app that requests it, but the
+        // grant can be missing from checkUidPermission() while PACKAGE_ADDED is delivered.
+        private boolean requestsInternetPermission(int uid) {
+            final String[] packageNames = mContext.getPackageManager().getPackagesForUid(uid);
+            if (packageNames == null) return false;
+            for (String packageName : packageNames) {
+                try {
+                    final PackageInfo info = mContext.getPackageManager().getPackageInfo(
+                            packageName, PackageManager.GET_PERMISSIONS
+                                    | PackageManager.MATCH_UNINSTALLED_PACKAGES);
+                    if (ArrayUtils.contains(info.requestedPermissions,
+                            Manifest.permission.INTERNET)) {
+                        return true;
+                    }
+                } catch (PackageManager.NameNotFoundException ignored) {
+                }
+            }
+            return false;
+        }
